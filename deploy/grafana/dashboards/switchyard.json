        "y": 53
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source) (delta(switchyard_savings_usd_total{instance=~\"$instance\"}[$__range]))",
