    },
    {
      "type": "stat",
      "title": "Savings in range",
      "description": "Savings in USD against each policy's baseline model over the time range, by source: routing and cache.",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
