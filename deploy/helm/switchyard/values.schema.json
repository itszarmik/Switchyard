{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Switchyard chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "duration": {
      "description": "A Go duration string with a unit, such as 0s, 5s, 1m30s or 2h (the gateway rejects bare numbers, 0 included), or a ${VAR} reference; null for the gateway's default.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^((([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+|.*\\$\\{.*\\}.*)$"
        }
      ]
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "list": {
      "type": "array",
      "items": { "type": "object" }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "probeSuccessOnce": {
      "description": "A liveness or startup probe: Kubernetes requires successThreshold 1.",
      "allOf": [
        { "$ref": "#/definitions/probe" },
        { "properties": { "successThreshold": { "const": 1 } } }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" },
        "claims": { "type": "array" }
      }
    }
  },
  "properties": {
    "global": {
      "description": "Helm's global values, for use as a subchart.",
      "type": "object"
    },
    "replicaCount": {
      "description": "Gateway replicas; at least 1 (3 or more for high availability).",
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "description": "An image digest, sha256:<64 hex digits>, or empty.",
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "env": {
          "description": "Environment variables for the Secret: names are environment variable names, values strings.",
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/envName" },
          "additionalProperties": { "type": "string" },
          "properties": {
            "SWITCHYARD_ADMIN_TOKEN": {
              "description": "The admin token: at least 32 characters, no whitespace or control characters.",
              "$comment": "No pattern or enum on a secret value: helm's error for them quotes the value. minLength reports only the length; switchyard.checkSecrets checks the characters.",
              "type": "string",
              "minLength": 32
            },
            "DATABASE_URL": { "type": "string", "minLength": 1 },
            "REDIS_CACHE_URL": { "type": "string", "minLength": 1 },
            "REDIS_STATE_URL": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "$ref": "#/definitions/envName" } }
      }
    },
    "extraEnvFrom": { "$ref": "#/definitions/list" },
    "config": {
      "description": "The Switchyard config, merged over files/switchyard.yaml. Only the fields the chart reads are checked here; the gateway validates the rest at startup.",
      "type": "object",
      "properties": {
        "server": {
          "type": ["object", "null"],
          "properties": {
            "listen": { "type": "string" },
            "admin_listen": { "type": "string" },
            "shutdown_delay": { "$ref": "#/definitions/duration" },
            "shutdown_grace": { "$ref": "#/definitions/duration" }
          }
        },
        "include": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundled": { "type": "boolean" },
        "extraFiles": {
          "description": "Catalog files, name.yaml: content.",
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.yaml$" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "$ref": "#/definitions/port" },
        "nodePort": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 65535 }
          ]
        },
        "externalTrafficPolicy": { "enum": ["", "Cluster", "Local"] },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "$ref": "#/definitions/port" }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^([0-9]+(ms|s|m|h))+$" },
            "labels": { "$ref": "#/definitions/stringMap" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "$ref": "#/definitions/stringMap" }
          }
        }
      }
    },
    "resources": { "$ref": "#/definitions/resources" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "$ref": "#/definitions/probeSuccessOnce" },
        "liveness": { "$ref": "#/definitions/probeSuccessOnce" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "extraMetrics": { "$ref": "#/definitions/list" },
        "behavior": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": {
          "description": "A number of pods (at least 1) or a percentage above 0 such as 25%: 0 would block every node drain.",
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "pattern": "^0*[1-9][0-9]*%$" }
          ]
        }
      }
    },
    "topologySpreadConstraints": { "$ref": "#/definitions/list" },
    "affinity": { "type": "object" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "$ref": "#/definitions/list" },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": {
      "description": "null derives it from the config; otherwise whole seconds.",
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "extraVolumes": { "$ref": "#/definitions/list" },
    "extraVolumeMounts": { "$ref": "#/definitions/list" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "$ref": "#/definitions/list" },
        "metricsFrom": { "$ref": "#/definitions/list" },
        "egress": { "$ref": "#/definitions/list" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": { "$ref": "#/definitions/resources" }
      }
    }
  }
}
