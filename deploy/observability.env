# Overlay for the observability profile: send traces to the profile's
# Jaeger. `make compose-up PROFILES=observability` passes it after .env:
#
#   docker compose --profile observability --env-file .env --env-file observability.env up -d --wait
#
# or set the same variable in .env instead. No secrets here.
SWITCHYARD_TRACING_ENABLED=true
