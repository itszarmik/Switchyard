# Keep the build context small. The Dockerfile copies only go.mod, go.sum,
# cmd/, internal/ and configs/quickstart.yaml.
.git
.github
bin
dist
docs
test
coverage.*
*.out
*.test
# Secrets, at any depth: deploy/.env holds every key of the compose stack.
**/.env
**/.env.*
**/.DS_Store
.idea
.vscode
tmp
